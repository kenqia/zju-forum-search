{
  "manifest_version": 3,
  "name": "浙大社区自然语言搜索",
  "version": "0.3.0",
  "description": "在 CC98 用自然语言检索帖子；朵朵校友圈仍在适配。",
  "action": {
    "default_title": "打开社区自然语言搜索"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.cc98.org/*",
    "https://api.duoduo.link/*",
    "https://webvpn.zju.edu.cn/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.cc98.org/*",
        "https://www.duoduo.link/*",
        "https://webvpn.zju.edu.cn/https/77726476706e69737468656265737421e7e056d22433310830079bab/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://webvpn.zju.edu.cn/https/77726476706e69737468656265737421e7e056d22433310830079bab/*"
      ],
      "js": [
        "cc98-webvpn-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
