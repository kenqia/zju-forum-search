{
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build && vite build --config vite.background.config.ts && vite build --config vite.bridge.config.ts && npm run verify:dist",
    "verify:dist": "node scripts/verify-extension-build.mjs",
    "relay:build": "tsc -p ../relay/tsconfig.json && vite build --config vite.relay.config.ts",
    "test": "vitest run --maxWorkers=1",
    "check": "npm run typecheck && npm test && npm run test:release && npm run build && npm run relay:build",
    "test:release": "python3 -m unittest discover -s scripts -p \"test_release.py\"",
    "release:prepare": "python3 scripts/release.py prepare",
    "release:verify": "python3 scripts/release.py verify"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@vitejs/plugin-react": "latest",
    "lucide-react": "^1.47.0",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "jsdom": "latest",
    "vitest": "latest"
  }
}
